# Application
APP_NAME=NEXORA
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Embeddings
EMBEDDING_MODEL=

# Database
DATABASE_URL=sqlite:///./nexora.db

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# File storage
UPLOAD_DIRECTORY=./storage/uploads
EXPORT_DIRECTORY=./storage/exports

# Retrieval
SPARSE_WEIGHT=
DENSE_WEIGHT=
TOP_K=5
MAX_AGENT_ITERATIONS=3
